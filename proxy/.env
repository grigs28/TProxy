HOST_IP=192.168.0.18
CACHE_BASE=/mnt/HDD/tproxy-cache

# registry:2 多实例共享的 HTTP secret（用于 upload 状态一致性）。
# 仅监听 127.0.0.1，未启用 registry 自身的认证，但仍不应硬编码进 compose。
REGISTRY_HTTP_SECRET=tproxy-shared-secret

# 客户端软件发布目录（NAS）。换根 CA 后，新根要发布到这里供客户端下载。
# 容器内挂到 /opt/TProxy/dist，manager 的 TPROXY_DIST_DIR 指向挂载点。
# 改这里要同时确认 .18 上该路径已挂载且可写。
DIST_DIR=/mnt/79-sxiad/grigs/tp
