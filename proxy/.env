# ============================================
# Proxy Manager 环境配置文件
# ============================================
# 修改此文件后，在 Proxy Manager Web 界面点击保存
# 系统会自动生成 tengine/nginx.conf 和 dnsmasq/dnsmasq.conf
# 然后重启相关容器使配置生效
#
# 注意: host 网络模式下，容器共享宿主机网络，无需配置容器端口

# --------------------------------------------
# 网络配置
# --------------------------------------------

# Docker 网络模式 (host/bridge)
# host: 直接使用宿主机网络，性能最佳（推荐）
# bridge: Docker 桥接网络，更灵活但性能略低
NETWORK_MODE=host

# 本机 IP 地址
# 用于 DNS 监听和状态页访问控制
HOST_IP=192.168.0.36

# --------------------------------------------
# 端口配置
# --------------------------------------------
# 注意: host 模式下只需要配置 HOST_PORT，bridge 模式需要额外映射

# Proxy Manager Web 控制台端口
PROXY_MANAGER_PORT=5557

# DNS 服务端口 (Dnsmasq)
DNSMASQ_HOST_PORT=53

# HTTP/HTTPS 代理端口 (Tengine)
PROXY_HOST_PORT=3128

# 状态监控页端口 (Tengine stub_status)
STATUS_HOST_PORT=8088

# --------------------------------------------
# 缓存配置 (Tengine)
# --------------------------------------------

# 缓存根目录
CACHE_BASE=/mnt/HDD/TProxy/cache

# 缓存最大大小 (例如: 1800g, 500g)
CACHE_MAX_SIZE=1800g

# 缓存键区域内存大小 (例如: 512m, 1g)
CACHE_KEYS_ZONE=512m

# 缓存过期时间 (例如: 30d, 7d)
CACHE_INACTIVE=30d

# 最小保留磁盘空间 (例如: 50g, 100g)
CACHE_MIN_FREE=50g

# 缓存子目录级别 (默认: 1:2)
CACHE_LEVELS=1:2

# --------------------------------------------
# Nginx/Tengine 性能配置
# --------------------------------------------

# Worker 进程数 (auto = 自动检测 CPU 核心数)
NGINX_WORKER_PROCESSES=auto

# Worker 连接数
NGINX_WORKER_CONNECTIONS=4096

# 文件描述符限制
NGINX_RLIMIT_NOFILE=65535

# --------------------------------------------
# 代理超时配置
# --------------------------------------------

# 连接超时 (秒)
PROXY_CONNECT_TIMEOUT=20

# 读取超时 (秒)
PROXY_READ_TIMEOUT=60

# 发送超时 (秒)
PROXY_SEND_TIMEOUT=60

# --------------------------------------------
# DNS 配置 (Dnsmasq)
# --------------------------------------------

# 上游 DNS 服务器 (多个用空格分隔)
DNS_SERVERS=223.5.5.5 223.6.6.6 119.29.29.29

# DNS 缓存条目数
DNS_CACHE_SIZE=10000

# DNS 最小缓存 TTL (秒)
DNS_MIN_CACHE_TTL=300

# --------------------------------------------
# CONNECT 方法允许的端口 (HTTPS 代理)
# --------------------------------------------

# 允许的 HTTPS 端口 (空格分隔)
PROXY_CONNECT_PORTS=443 80 8080 8443

# --------------------------------------------
# 状态页访问控制 (CIDR 格式)
# --------------------------------------------

# 允许访问状态页的网段 (空格分隔)
STATUS_ALLOW_NETS=192.168.91.0/24 192.168.92.0/24 192.168.93.0/24 192.168.94.0/24

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 访问日志级别 (debug, info, notice, warn, error, crit)
NGINX_LOG_LEVEL=warn

# --------------------------------------------
# 缓存目录分类 (用于缓存清理)
# --------------------------------------------

# 缓存类型目录 (按域名或类型分类)
CACHE_TYPES=docker yum github other

# --------------------------------------------
# Proxy Manager 系统配置
# --------------------------------------------

# 随系统启动 (true/false)
# true: 开机自动启动 Proxy Manager 服务
# false: 需要手动启动
AUTO_START=true